    append_log_from_stdin "${notebook_path}" "01_safe.py" 'r"""' <<'LOG'
docstring delimiter seen: '''
regex: \d{4}-\d{2} path C:\new
Exit code: 0
LOG

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
