    ! grep -F '## Execution-Log Literal Warnings' "${output_root}/MANIFEST.md"
}

@test "log with three- and four-backtick fence lines decompiles verbatim inside a longer outer fence" {
    local notebook_path="${TEST_DIR}/long-fence-log.py"
    local output_root="${TEST_DIR}/long-fence-log-output"
    local extracted_script="${output_root}/stage5_fetch/01_safe.py"

    write_archive_prefix \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    # The longest backtick run in the log is 4, so the outer fence is 5.
    append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''" '`````' <<'LOG'
Markdown printed by the script:
```
inside a three-backtick fence
```
````python
inside a four-backtick fence
````
~~~
tilde fence
~~~
Exit code: 0
LOG

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    refute_output --partial "can close its code fence early"
    grep -Fx '# ```' "${extracted_script}"
    grep -Fx '# ````python' "${extracted_script}"
    grep -Fx '# ````' "${extracted_script}"
    grep -Fx '# ~~~' "${extracted_script}"
    grep -Fx '# Exit code: 0' "${extracted_script}"
    [ "$(grep -c '^# ```$' "${extracted_script}")" -eq 2 ]
    grep -F '**Execution logs with a line that can close their code fence early:** 0' \
        "${output_root}/MANIFEST.md"
    ! grep -F '## Execution-Log Fence Warnings' "${output_root}/MANIFEST.md"
}

@test "three-backtick fence still decompiles and warns about a log line that can close it early" {
    local notebook_path="${TEST_DIR}/short-fence-log.py"
    local output_root="${TEST_DIR}/short-fence-log-output"
    local extracted_script="${output_root}/stage5_fetch/01_safe.py"

    write_archive_prefix \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''" <<'LOG'
inline ``` run mid-line does not close a fence
```
Exit code: 0
LOG

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    assert_output --partial "WARNING: stage5_fetch/01_safe.py (log line 2) — execution-log line can close its code fence early"
    grep -Fx '# inline ``` run mid-line does not close a fence' "${extracted_script}"
    grep -Fx '# ```' "${extracted_script}"
    grep -Fx '# Exit code: 0' "${extracted_script}"
    grep -F '## Execution-Log Fence Warnings' "${output_root}/MANIFEST.md"
    grep -F '| `stage5_fetch/01_safe.py` | 2 | execution-log line can close its code fence early' \
        "${output_root}/MANIFEST.md"
    grep -F '**Execution logs with a line that can close their code fence early:** 1' \
        "${output_root}/MANIFEST.md"
}

@test "legacy non-raw log literal with a carriage-return escape warns about a fence line after the CR" {
    local notebook_path="${TEST_DIR}/legacy-nonraw-cr-fence.py"
    local output_root="${TEST_DIR}/legacy-nonraw-cr-fence-output"

    write_archive_prefix \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    # The \r escapes decode to carriage returns, which Python-Markdown reads as
    # line breaks, so the display shows "```" as log line 3.
    append_log_from_stdin "${notebook_path}" "01_safe.py" "'''" <<'LOG'
Exit code: 0
before\r```\rafter
LOG

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    assert_output --partial "WARNING: stage5_fetch/01_safe.py (log line 3) — execution-log line can close its code fence early"
    assert_output --partial "legacy non-raw execution-log literal contains backslashes"
    grep -F '| `stage5_fetch/01_safe.py` | 3 | execution-log line can close its code fence early' \
        "${output_root}/MANIFEST.md"
    grep -F '**Execution logs with a line that can close their code fence early:** 1' \
        "${output_root}/MANIFEST.md"
}

@test "opening and closing fences of different lengths are rejected" {
    local notebook_path
    local output_root
    local -a fence_pairs=('````|```' '```|````')
    local pair
    local case_index=0

    for pair in "${fence_pairs[@]}"; do
        case_index=$((case_index + 1))
        notebook_path="${TEST_DIR}/fence-mismatch-${case_index}.py"
        output_root="${TEST_DIR}/fence-mismatch-${case_index}-output"
        write_archive_prefix \
            "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
            "stage5_fetch/01_safe.py"
        append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''" \
            "${pair%%|*}" "${pair##*|}" <<'LOG'
Exit code: 0
LOG

        assert_rejected_without_outputs \
            "${notebook_path}" "${output_root}" \
            "execution-log markdown must contain exactly one complete plain fenced body"
    done
}

@test "form feed U+2028 and U+0085 in a log round-trip without extra line breaks" {
    local notebook_path="${TEST_DIR}/separator-log.py"
    local output_root="${TEST_DIR}/separator-log-output"
    local extracted_script="${output_root}/stage5_fetch/01_safe.py"

    write_archive_prefix \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    printf 'page\fbreak\nline\xe2\x80\xa8sep\nnext\xc2\x85line\nvt\vtab\nExit code: 0\n' \
        | append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''"

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    grep -Fx "$(printf '# page\fbreak')" "${extracted_script}"
    grep -Fx "$(printf '# line\xe2\x80\xa8sep')" "${extracted_script}"
    grep -Fx "$(printf '# next\xc2\x85line')" "${extracted_script}"
    grep -Fx "$(printf '# vt\vtab')" "${extracted_script}"
    ! grep -Fx '# page' "${extracted_script}"
    ! grep -Fx '# break' "${extracted_script}"
}

@test "CRLF notebook decompiles exactly like its LF original" {
    local lf_notebook="${TEST_DIR}/lf.py"
    local crlf_notebook="${TEST_DIR}/crlf.py"
    local lf_output="${TEST_DIR}/lf-output"
    local crlf_output="${TEST_DIR}/crlf-output"

    cp "${FIXTURE}" "${lf_notebook}"
    sed 's/$/\r/' "${FIXTURE}" > "${crlf_notebook}"
    grep -q $'\r$' "${crlf_notebook}"

    run python3 "${DECOMPILER}" "${lf_notebook}" "${lf_output}"
    assert_success
    run python3 "${DECOMPILER}" "${crlf_notebook}" "${crlf_output}"
    assert_success

    cmp "${lf_output}/stage5_fetch/01_write-fixture.py" \
        "${crlf_output}/stage5_fetch/01_write-fixture.py"
    ! grep -q $'\r' "${crlf_output}/stage5_fetch/01_write-fixture.py"
}

@test "canonical log with early printed banner and marker lines round-trips verbatim" {
    local notebook_path="${TEST_DIR}/printed-banner-log.py"
    local output_root="${TEST_DIR}/printed-banner-log-output"
    local extracted_script="${output_root}/stage5_fetch/01_safe.py"

    write_archive_prefix \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''" <<'LOG'

Executed: 2026-10-19 12:00:00
Exit code: 0
--- STDOUT ---
# ====================
# EXECUTION LOG
# ====================
report printed above
LOG

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    # The rebuilt script has exactly one marker line: the banner the
    # decompiler adds above the log, not a printed line stripped of its '# '.
    [ "$(grep -cx '# EXECUTION LOG' "${extracted_script}")" -eq 1 ]
    grep -Fx '# # ====================' "${extracted_script}"
    grep -Fx '# # EXECUTION LOG' "${extracted_script}"
    grep -Fx '# Executed: 2026-10-19 12:00:00' "${extracted_script}"
    grep -Fx '# report printed above' "${extracted_script}"
}

@test "legacy pre-commented logs with or without the banner are still un-commented once" {
    local mode
    local notebook_path
    local output_root
    local extracted_script

    for mode in banner marker; do
        notebook_path="${TEST_DIR}/precommented-${mode}.py"
        output_root="${TEST_DIR}/precommented-${mode}-output"
        extracted_script="${output_root}/stage5_fetch/01_safe.py"
        write_archive_prefix \
            "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
            "stage5_fetch/01_safe.py"
        {
            if [ "${mode}" = "banner" ]; then
                printf '%s\n' '# ============================================================================='
            fi
            printf '%s\n' \
                '# EXECUTION LOG' \
                '# =============================================================================' \
                '#' \
                '# Executed: 2026-01-01 00:00:00' \
                '# Exit code: 0' \
                '# # printed hash line'
        } | append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''"

        run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

        assert_success
        [ "$(grep -cx '# EXECUTION LOG' "${extracted_script}")" -eq 1 ]
        ! grep -Fx '# # EXECUTION LOG' "${extracted_script}"
        grep -Fx '# Executed: 2026-01-01 00:00:00' "${extracted_script}"
        grep -Fx '# # printed hash line' "${extracted_script}"
        ! grep -Fx '# # Exit code: 0' "${extracted_script}"
    done
}

@test "legacy pre-commented logs starting at a bare hash or the Executed line are un-commented once" {
    local mode
    local notebook_path
    local output_root
    local extracted_script

    for mode in hash executed canonical; do
        notebook_path="${TEST_DIR}/precommented-start-${mode}.py"
        output_root="${TEST_DIR}/precommented-start-${mode}-output"
        extracted_script="${output_root}/stage5_fetch/01_safe.py"
        write_archive_prefix \
            "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
            "stage5_fetch/01_safe.py"
        {
            case "${mode}" in
                hash)
                    printf '%s\n' '#' '# Executed: 2026-01-01 00:00:00'
                    ;;
                executed)
                    printf '%s\n' '# Executed: 2026-01-01 00:00:00'
                    ;;
                canonical)
                    # Canonical control: the uncommented Executed line keeps
                    # the log canonical, so its printed hash line stays "# # ".
                    printf '%s\n' 'Executed: 2026-01-01 00:00:00'
                    ;;
            esac
            if [ "${mode}" = "canonical" ]; then
                printf '%s\n' 'Exit code: 0' '# printed hash line'
            else
                printf '%s\n' '# Exit code: 0' '# # printed hash line'
            fi
        } | append_log_from_stdin "${notebook_path}" "01_safe.py" "r'''"

        run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

        assert_success
        [ "$(grep -cx '# EXECUTION LOG' "${extracted_script}")" -eq 1 ]
        grep -Fx '# Executed: 2026-01-01 00:00:00' "${extracted_script}"
        ! grep -Fx '# # Executed: 2026-01-01 00:00:00' "${extracted_script}"
        grep -Fx '# Exit code: 0' "${extracted_script}"
        ! grep -Fx '# # Exit code: 0' "${extracted_script}"
        grep -Fx '# # printed hash line' "${extracted_script}"
    done
}

@test "generic Marimo application and zero-script DAAF archive are rejected" {
    local generic_notebook="${TEST_DIR}/generic.py"
    local generic_output="${TEST_DIR}/generic-output"
    local zero_notebook="${TEST_DIR}/zero.py"
    local zero_output="${TEST_DIR}/zero-output"

    cat > "${generic_notebook}" <<'PY'
import marimo
app = marimo.App()
@app.cell
def _():
    print("ordinary marimo application")
PY
    assert_rejected_without_outputs \
        "${generic_notebook}" "${generic_output}" \
        "arbitrary marimo applications are not accepted"

    cat > "${zero_notebook}" <<'PY'
"""
This notebook DISPLAYS the executed scripts from the scripts/ directory.
It does NOT contain new analysis code.
Generated by notebook-assembler agent.
"""
import marimo
app = marimo.App()
@app.cell
def _(mo):
    mo.md("No archived scripts")
PY
    assert_rejected_without_outputs \
        "${zero_notebook}" "${zero_output}" "no valid script bundles found"
}

@test "missing empty malformed and placeholder execution logs are rejected" {
    local mode
    local notebook_path
    local output_root
    local expected_message

    for mode in missing empty malformed placeholder; do
        notebook_path="${TEST_DIR}/${mode}-log.py"
        output_root="${TEST_DIR}/${mode}-log-output"
        write_archive \
            "${notebook_path}" "scripts/stage5_fetch/01_safe.py" "${mode}"
        case "${mode}" in
            missing)
                expected_message="must be followed immediately"
                ;;
            empty)
                expected_message="execution log is empty"
                ;;
            malformed)
                expected_message="execution-log markdown must contain exactly one complete plain fenced body"
                ;;
            placeholder)
                expected_message="placeholder rather than archived execution evidence"
                ;;
        esac
        assert_rejected_without_outputs \
            "${notebook_path}" "${output_root}" "${expected_message}"
    done
}

@test "empty and whitespace-only archived Python source bodies are rejected atomically" {
    local notebook_path="${TEST_DIR}/empty-source.py"
    local output_root="${TEST_DIR}/empty-source-output"

    write_archive "${notebook_path}" "scripts/stage5_fetch/01_safe.py" valid
    replace_once \
        "${notebook_path}" \
        '    # print("ARCHIVE CODE")' \
        '    #    '

    assert_rejected_without_outputs \
        "${notebook_path}" "${output_root}" "archive source code is empty"
}

@test "all canonical execution-log placeholder classes are rejected case-insensitively" {
    local payload
    local notebook_path
    local output_root
    local case_index=0
    local -a placeholder_payloads=(
        $'=== EXECUTION LOG ===\n  NO EXECUTION LOG FOUND!!!  '
        '[TODO]'
        '--- tBd ---'
        '# *** Generic Placeholder ***'
        'Please paste the execution log here later.'
        'COPY the complete execution log from the script later!!!'
        '(add actual execution log below later)'
        'VERBATIM COPY FROM SCRIPT.'
    )

    for payload in "${placeholder_payloads[@]}"; do
        case_index=$((case_index + 1))
        notebook_path="${TEST_DIR}/placeholder-${case_index}.py"
        output_root="${TEST_DIR}/placeholder-${case_index}-output"
        write_archive "${notebook_path}" "scripts/stage5_fetch/01_safe.py" valid
        replace_once \
            "${notebook_path}" \
            $'EXECUTION LOG\nExit code: 0' \
            "${payload}"

        assert_rejected_without_outputs \
            "${notebook_path}" "${output_root}" \
            "placeholder rather than archived execution evidence"
    done
}

@test "substantive execution log containing a normal TODO word is accepted" {
    local notebook_path="${TEST_DIR}/substantive-todo-log.py"
    local output_root="${TEST_DIR}/substantive-todo-log-output"

    write_archive "${notebook_path}" "scripts/stage5_fetch/01_safe.py" valid
    replace_once \
        "${notebook_path}" \
        $'EXECUTION LOG\nExit code: 0' \
        $'Executed: 2026-07-16 19:00:00 UTC\nTODO checks completed successfully\nExit code: 0'

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    [ -f "${output_root}/stage5_fetch/01_safe.py" ]
    [ -f "${output_root}/MANIFEST.md" ]
}

@test "delayed mismatched and duplicate log associations are rejected" {
    local delayed_notebook="${TEST_DIR}/delayed-log.py"
    local delayed_output="${TEST_DIR}/delayed-log-output"
    local mismatch_notebook="${TEST_DIR}/mismatch-log.py"
    local mismatch_output="${TEST_DIR}/mismatch-log-output"
    local duplicate_notebook="${TEST_DIR}/duplicate-log.py"
    local duplicate_output="${TEST_DIR}/duplicate-log-output"

    write_archive \
        "${delayed_notebook}" "scripts/stage5_fetch/01_safe.py" missing
    cat >> "${delayed_notebook}" <<'PY'

@app.cell
def _(mo):
    mo.md("Narrative content delays the log")
    return
PY
    append_valid_log "${delayed_notebook}" "01_safe.py"
    assert_rejected_without_outputs \
        "${delayed_notebook}" "${delayed_output}" "must be followed immediately"

    write_archive \
        "${mismatch_notebook}" "scripts/stage5_fetch/01_safe.py" valid \
        "stage5_fetch/01_safe.py" "02_wrong.py"
    assert_rejected_without_outputs \
        "${mismatch_notebook}" "${mismatch_output}" "execution-log/source mismatch"

    write_archive \
        "${duplicate_notebook}" "scripts/stage5_fetch/01_safe.py" valid
    append_valid_log "${duplicate_notebook}" "01_safe.py"
    assert_rejected_without_outputs \
        "${duplicate_notebook}" "${duplicate_output}" "duplicate execution-log accordion"
}

@test "absolute backslash traversal leading-dash and extra-depth paths are rejected" {
    local source_path
    local notebook_path
    local output_root
    local case_index=0
    local -a unsafe_paths=(
        '/daaf/scripts/scratch/absolute-escape.py'
        'scripts/stage5_fetch\escaped.py'
        'scripts/stage5_fetch/../escaped.py'
        'scripts/stage5_fetch/-unsafe.py'
        'scripts/stage5_fetch/extra/escaped.py'
    )

    for source_path in "${unsafe_paths[@]}"; do
        case_index=$((case_index + 1))
        notebook_path="${TEST_DIR}/unsafe-${case_index}.py"
        output_root="${TEST_DIR}/unsafe-${case_index}-output"
        write_archive "${notebook_path}" "${source_path}" valid

        run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

        assert_failure
        assert_output --partial "SOURCE"
        [ ! -e "${output_root}" ]
    done
}

@test "noncanonical stage and non-py extensions are rejected" {
    local notebook_path="${TEST_DIR}/invalid-stage.py"
    local output_root="${TEST_DIR}/invalid-stage-output"

    write_archive \
        "${notebook_path}" "scripts/stage4_plan/01_safe.py" valid
    assert_rejected_without_outputs \
        "${notebook_path}" "${output_root}" "noncanonical stage directory"

    notebook_path="${TEST_DIR}/invalid-extension.py"
    output_root="${TEST_DIR}/invalid-extension-output"
    write_archive \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.R" valid
    assert_rejected_without_outputs \
        "${notebook_path}" "${output_root}" "does not end in .py"
}

@test "malformed and duplicate SOURCE markers are rejected" {
    local malformed_notebook="${TEST_DIR}/malformed-source.py"
    local malformed_output="${TEST_DIR}/malformed-source-output"
    local duplicate_notebook="${TEST_DIR}/duplicate-source-marker.py"
    local duplicate_output="${TEST_DIR}/duplicate-source-marker-output"

    cat > "${malformed_notebook}" <<'PY'
"""Generated by notebook-assembler agent."""
import marimo
app = marimo.App()
@app.cell
def _():
    # SOURCE scripts/stage5_fetch/01_safe.py
    pass  # Cell must have executable statement
PY
    assert_rejected_without_outputs \
        "${malformed_notebook}" "${malformed_output}" "malformed SOURCE marker"

    write_archive_prefix \
        "${duplicate_notebook}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    sed -i \
        '/# ARCHIVED SCRIPT CODE/i\    # SOURCE: scripts/stage5_fetch/01_safe.py' \
        "${duplicate_notebook}"
    append_valid_log "${duplicate_notebook}" "01_safe.py"
    assert_rejected_without_outputs \
        "${duplicate_notebook}" "${duplicate_output}" "duplicate SOURCE markers"
}

@test "duplicate source paths across otherwise valid bundles are rejected" {
    local notebook_path="${TEST_DIR}/duplicate-source.py"
    local output_root="${TEST_DIR}/duplicate-source-output"

    write_archive \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" valid
    append_bundle "${notebook_path}" "stage5_fetch/01_safe.py" yes

    assert_rejected_without_outputs \
        "${notebook_path}" "${output_root}" "duplicate SOURCE path"
}

@test "header mismatch and unsafe uncommented archive content are rejected" {
    local mismatch_notebook="${TEST_DIR}/header-mismatch.py"
    local mismatch_output="${TEST_DIR}/header-mismatch-output"
    local live_notebook="${TEST_DIR}/live-content.py"
    local live_output="${TEST_DIR}/live-content-output"

    write_archive \
        "${mismatch_notebook}" "scripts/stage5_fetch/01_safe.py" valid \
        "stage5_fetch/02_other.py"
    assert_rejected_without_outputs \
        "${mismatch_notebook}" "${mismatch_output}" "script header/source mismatch"

    write_archive \
        "${live_notebook}" "scripts/stage5_fetch/01_safe.py" valid
    sed -i 's/    # print("ARCHIVE CODE")/    print("LIVE CODE")/' \
        "${live_notebook}"
    assert_rejected_without_outputs \
        "${live_notebook}" "${live_output}" "not safely comment-prefixed"
}

@test "later invalid bundle leaves no partial scripts or manifest" {
    local notebook_path="${TEST_DIR}/late-invalid.py"
    local output_root="${TEST_DIR}/late-invalid-output"

    write_archive \
        "${notebook_path}" "scripts/stage5_fetch/01_valid.py" valid \
        "stage5_fetch/01_valid.py"
    append_bundle "${notebook_path}" "stage6_clean/02_missing-log.py" no

    assert_rejected_without_outputs \
        "${notebook_path}" "${output_root}" "must be followed immediately"
    [ ! -e "${output_root}/stage5_fetch/01_valid.py" ]
    [ ! -e "${output_root}/MANIFEST.md" ]
}

@test "pre-existing output root is preserved and never merged or overwritten" {
    local output_root="${TEST_DIR}/existing-output"
    local sentinel="${output_root}/keep-me.txt"

    mkdir -p "${output_root}"
    printf '%s\n' 'preserve existing content' > "${sentinel}"

    run python3 "${DECOMPILER}" "${FIXTURE}" "${output_root}"

    assert_failure
    assert_output --partial "output directory already exists"
    grep -Fx 'preserve existing content' "${sentinel}"
    [ ! -e "${output_root}/stage5_fetch/01_write-fixture.py" ]
    [ ! -e "${output_root}/MANIFEST.md" ]
}

@test "dangling-reference analysis parses but never evaluates notebook-derived code" {
    local notebook_path="${TEST_DIR}/no-evaluation.py"
    local output_root="${TEST_DIR}/no-evaluation-output"
    local sentinel_path="${TEST_DIR}/must-not-be-created.txt"

    cat > "${notebook_path}" <<PY
#!/usr/bin/env python3
"""Generated by notebook-assembler agent."""
import marimo
app = marimo.App()

@app.cell
def _(mo):
    mo.md("""
    ### 5.1: Static Analysis Safety Fixture
    **Script:** \`scripts/stage5_fetch/01_untrusted.py\`
    **Output:** \`output/untrusted.txt\`
    **Status:** CP1 PASSED
    """)
    return

@app.cell
def _():
    # SOURCE: scripts/stage5_fetch/01_untrusted.py
    # ===========================================================================
    # ARCHIVED SCRIPT CODE (commented out to prevent execution conflicts)
    # Full executable script preserved at: scripts/stage5_fetch/01_untrusted.py
    # ===========================================================================
    #
    # from pathlib import Path
    # Path("${sentinel_path}").write_text("PWNED", encoding="utf-8")
    # undefined_review_prompt
    #
    pass  # Cell must have executable statement
    return

@app.cell
def _(mo):
    mo.accordion({"Execution Log (01_untrusted.py)": mo.md(r'''\`\`\`
EXECUTION LOG
Exit code: 0
\`\`\`''')})
    return
PY

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    assert_output --partial "dangling references: undefined_review_prompt"
    [ -f "${output_root}/stage5_fetch/01_untrusted.py" ]
    [ -f "${output_root}/MANIFEST.md" ]
    [ ! -e "${sentinel_path}" ]
}
