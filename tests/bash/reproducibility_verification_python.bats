}

@test "legacy non-raw log literal with a backslash decompiles with a fidelity warning" {
    local notebook_path="${TEST_DIR}/legacy-nonraw-backslash.py"
    local output_root="${TEST_DIR}/legacy-nonraw-backslash-output"

    write_archive_prefix \
        "${notebook_path}" "scripts/stage5_fetch/01_safe.py" \
        "stage5_fetch/01_safe.py"
    append_log_from_stdin "${notebook_path}" "01_safe.py" "'''" <<'LOG'
Saved to C:\new\table\out.parquet
Exit code: 0
LOG

    run python3 "${DECOMPILER}" "${notebook_path}" "${output_root}"

    assert_success
    assert_output --partial "WARNING: stage5_fetch/01_safe.py — legacy non-raw execution-log literal contains backslashes; archived log may not be verbatim — compare with the original script"
    [ -f "${output_root}/stage5_fetch/01_safe.py" ]
    grep -F '## Execution-Log Literal Warnings' "${output_root}/MANIFEST.md"
    grep -F '| `stage5_fetch/01_safe.py` | legacy non-raw execution-log literal contains backslashes' \
        "${output_root}/MANIFEST.md"
    grep -F '**Legacy non-raw execution-log literals with backslashes:** 1' \
        "${output_root}/MANIFEST.md"
}

